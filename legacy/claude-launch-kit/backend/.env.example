# --- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API setup) ---
WA_TOKEN=EAAG...                 # permanent System User token with whatsapp_business_messaging
WA_PHONE_NUMBER_ID=123456789012345
WA_APP_SECRET=abc123             # App settings > Basic > App secret (verifies webhook signatures)
WA_VERIFY_TOKEN=pick-any-long-random-string
GRAPH_VERSION=v27.0

# --- Instagram (Meta for Developers > your app > Instagram > API setup with Instagram login) ---
IG_TOKEN=IGAA...                 # Instagram user access token for your professional account (instagram_business_manage_messages)
IG_USER_ID=17841400000000000     # your Instagram professional account ID
IG_APP_SECRET=def456             # Instagram app secret (verifies Instagram webhook signatures)
IG_VERIFY_TOKEN=pick-another-long-random-string

# --- Claude API (console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...
MINDY_MODEL_FAST=claude-haiku-5-5
MINDY_MODEL_SMART=claude-sonnet-5-5

# --- App ---
DATABASE_PATH=./mindy.db
DEFAULT_TIMEZONE=Europe/London
ALLOWED_ORIGINS=https://whatsonyourmind.online,https://www.whatsonyourmind.online,https://app.whatsonyourmind.online
ADMIN_KEY=change-me              # protects /admin endpoints
REMINDER_TEMPLATE=mindy_reminder # approved template used outside the 24-hour window
TEMPLATE_LANG=en_GB

# --- The Mindy web app (served by this backend at /) ---
APP_URL=https://app.whatsonyourmind.online   # where the app lives (used in "login" replies)
PUBLIC_WA_NUMBER=447700900000                # Mindy's WhatsApp number, digits only (shown in the app)
PUBLIC_IG_HANDLE=whatsonyourmind
LOGIN_TEMPLATE=mindy_login_code              # Authentication template for sign-in codes (see TEMPLATES.md)
DEV_CODES=1                                  # 1 = show sign-in codes on screen while WhatsApp isn't connected (local only)
# Phone notifications (Web Push). Leave empty and keys are generated once and kept in the database.
VAPID_PRIVATE_KEY_PEM=
VAPID_SUBJECT=mailto:hello@whatsonyourmind.online
